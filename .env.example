# 选择一个 provider: openai-compatible / anthropic / gemini

LLM_PROVIDER=openai-compatible
LLM_TIMEOUT_SECONDS=60

# OpenAI-compatible 配置。
# OpenAI、DeepSeek、OpenRouter、OneAPI、New API、LiteLLM 和很多中转站都支持这种格式。
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-with-your-api-key
LLM_MODEL=gpt-4.1-mini

# Anthropic Claude 原生 API 配置。
# 使用时把 LLM_PROVIDER 改成 anthropic。
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_API_KEY=replace-with-your-anthropic-key
ANTHROPIC_MODEL=claude-sonnet-4-5

# Google Gemini 原生 API 配置。
# 使用时把 LLM_PROVIDER 改成 gemini。
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=replace-with-your-gemini-key
GEMINI_MODEL=gemini-2.5-pro
